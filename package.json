{
	"name": "task-cli",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"bundle": "tsx ci/scripts/bundle.ts",
		"build-launcher": "node ci/scripts/build-launcher.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"clean": "rimraf dist dist-types dist-bundle",
		"postinstall": "node scripts/setup-eslint-ts6.cjs"
	},
	"dependencies": {
		"@wadeck-app/shared-updater": "latest",
		"@wadeck-app/singleton-daemon-kit": "latest",
		"js-yaml": "^4.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.0.0",
		"@wadeck-app/shared-cli": "^2026.10.10-036-4b70545a",
		"esbuild": "^0.27.2",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^16.2.0",
		"prettier": "^3.4.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.7.0",
		"typescript": "^7.0.0",
		"typescript-6": "npm:typescript@^6",
		"typescript-eslint": "8.67.0",
		"vitest": "^4.0.14"
	}
}
