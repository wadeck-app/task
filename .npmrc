# Required for TypeScript 7 + typescript-eslint peer-dependency conflict.
# typescript-eslint declares peer dep: typescript >=4.8.4 <6.1.0
# Without this flag, npm install fails due to TS7 peer conflict.
# Remove together with scripts/setup-eslint-ts6.cjs and the typescript-6 devDependency
# once typescript-eslint officially supports TS7:
# https://github.com/typescript-eslint/typescript-eslint/issues/10940
legacy-peer-deps=true
