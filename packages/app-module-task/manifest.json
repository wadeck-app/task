{
	"id": "task",
	"dslLib": {
		"shared": {
			"react": "^19",
			"react-router-dom": "^7",
			"@wadeck-app/dsl-ui": ">=2026.10.3-0",
			"@wadeck-app/dsl-renderer": ">=2026.10.14-0"
		}
	},
	"lifecycle": {
		"teardown": "./src/backend/teardown.ts"
	},
	"expose": {
		"slots": {
			"project-header": {
				"accepts": ["ButtonLink", "IconButton", "Badge"]
			}
		}
	},
	"extensionPoints": [
		{
			"kind": "widget",
			"slot": "dashboard",
			"label": "Open Tasks",
			"width": 3,
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-widget.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Tasks",
			"path": "/tasks",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-page.yaml"
			},
			"count": {
				"route": "/tasks/open/count",
				"field": "count",
				"label": "open tasks",
				"refreshSeconds": 60
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Tree",
			"path": "/tree",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tree-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Projects",
			"path": "/projects",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/projects-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Types",
			"path": "/types",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/types-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "New task",
			"path": "/tasks/new",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/new-task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Delete tasks",
			"path": "/tasks/delete",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/delete-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/tasks/p/:project",
			"tab": {
				"group": "project",
				"label": "Tasks",
				"order": 10,
				"count": {
					"route": "/tasks/p/:project/open/count",
					"field": "count",
					"label": "open tasks",
					"refreshSeconds": 60
				}
			},
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Task",
			"path": "/tasks/p/:project/:id",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "New task",
			"path": "/tasks/p/:project/new",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/new-task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Delete tasks",
			"path": "/tasks/p/:project/delete",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/delete-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/tree/p/:project",
			"tab": {
				"group": "project",
				"label": "Tree",
				"order": 20
			},
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tree-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/types/p/:project",
			"tab": {
				"group": "project",
				"label": "Types",
				"order": 30,
				"count": {
					"route": "/types/p/:project/count",
					"field": "count",
					"label": "types",
					"refreshSeconds": 60
				}
			},
			"view": {
				"type": "path",
				"value": "./src/dsl-views/types-page.yaml"
			}
		}
	]
}
