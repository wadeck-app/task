{
	"id": "task",
	"dslLib": {
		"shared": {
			"react": "^19",
			"react-router-dom": "^7",
			"@wadeck-app/dsl-ui": ">=2026.10.3-0",
			"@wadeck-app/dsl-renderer": ">=2026.10.14-0"
		}
	},
	"lifecycle": {
		"teardown": "./src/backend/teardown.ts"
	},
	"extensionPoints": [
		{
			"kind": "widget",
			"slot": "dashboard",
			"label": "Open Tasks",
			"width": 3,
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-widget.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Tasks",
			"path": "/tasks",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Tree",
			"path": "/tree",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tree-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Projects",
			"path": "/projects",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/projects-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Types",
			"path": "/types",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/types-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "New task",
			"path": "/tasks/new",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/new-task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Delete tasks",
			"path": "/tasks/delete",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/delete-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/tasks/p/:project",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tasks-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Task",
			"path": "/tasks/p/:project/:id",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Task history",
			"path": "/tasks/p/:project/:id/history",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/task-history-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "New task",
			"path": "/tasks/p/:project/new",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/new-task-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Delete tasks",
			"path": "/tasks/p/:project/delete",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/delete-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/tree/p/:project",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tree-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Project",
			"path": "/types/p/:project",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/types-page.yaml"
			}
		}
	]
}
