				"type": "path",
				"value": "./src/dsl-views/tasks-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Tree",
			"path": "/tree",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/tree-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Projects",
			"path": "/projects",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/projects-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Types",
			"path": "/types",
