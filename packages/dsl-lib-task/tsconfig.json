{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"src",
		"test",
		"scripts",
		"tailwind.config.ts",
		"vitest.config.ts",
		"../app-module-task/src/dsl-components/index.ts"
	]
}
