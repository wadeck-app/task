{
	"name": "task-cli",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"bundle": "tsx ci/scripts/bundle.ts",
		"build-launcher": "node ci/scripts/build-launcher.mjs",
		"test": "vitest run --bail=1",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"preversion": "npm test",
		"clean": "rimraf dist dist-types dist-bundle"
	},
	"dependencies": {
		"@wadeck-app/task-core": "*",
		"@wadeck-app/shared-updater": "latest",
		"@wadeck-app/singleton-daemon-kit": "latest",
		"js-yaml": "^4.1.1"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.0.0",
		"@wadeck-app/shared-cli": "^2026.10.10-036-4b70545a",
		"esbuild": "^0.27.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.7.0",
		"typescript": "^7.0.0",
		"vitest": "^4.0.14"
	},
	"engines": {
		"node": ">=22"
	}
}
