#!/usr/bin/env node
'use strict';
// Shim of the `{{CLI_NAME}}` command (package @wadeck-app/{{PKG_PREFIX}}, bin/{{CLI_NAME}}.js), generated from
// ci/templates/bin-launcher.js.tmpl. Self-contained CommonJS: the logic is in run(deps) so tests can inject every
// side effect; the real wiring is at the bottom and only runs when this file is the entry point.
//
// Contract:
//  - Supported platforms: exactly the PLATFORMS list below, set at generation time. Any other host is
//    refused first thing, for every command, with exit 1: there is no partial support.
//  - Every command except `start` runs `node <bundle> <args>` directly, on ALL platforms. The Go launcher is a daemon
//    supervisor; a short-lived command does not need it (and on Windows its GUI-subsystem build swallows stdout).
//  - `start` goes through the Go launcher of the platform package (installed lazily, only then).
//  - A failure is NEVER silent: the shim prints what failed, the paths involved and the command that fixes it.

const BUNDLE_FILE = '{{CLI_NAME}}.cjs';
const WRAPPER_PKG = '@wadeck-app/{{PKG_PREFIX}}';
const PLATFORMS = '{{PLATFORMS}}'.split(',');
const PLATFORM_PKG = {};
for (const p of PLATFORMS) PLATFORM_PKG[p] = '@wadeck-app/{{PKG_PREFIX}}-' + p;

/**
 * @param {object} deps injected side effects
 * @param {string} deps.platform process.platform
 * @param {string} deps.arch os.arch()
 * @param {string[]} deps.args process.argv.slice(2)
 * @param {NodeJS.ProcessEnv} deps.env
 * @param {string} deps.nodePath process.execPath
 * @param {string} deps.bundlePath absolute path of the CLI bundle
 * @param {(p: string) => boolean} deps.exists
 * @param {(spec: string) => string} deps.resolve require.resolve of a platform package file; throws when absent
 * @param {(pkg: string) => void} deps.install global install of a package; throws {status, stdout, stderr} on failure
 * @param {(bin: string, args: string[], opts: object) => void} deps.execFile execFileSync; throws on failure
 * @param {(p: string) => void} deps.assertExecutable throws when the file is not executable
 * @param {(p: string) => void} deps.makeExecutable chmod +x; throws on failure
 * @param {NodeJS.WritableStream} deps.stdout only write(string) is used
 * @param {NodeJS.WritableStream} deps.stderr only write(string) is used
 * @returns {number} the exit code
 */
function run(deps) {
  const say = (line) => deps.stderr.write('{{CLI_NAME}}: ' + line + '\n');
  const key = deps.platform + '-' + deps.arch;

  // Before anything else (bundle check included): an unsupported host runs nothing and installs nothing.
  if (!Object.prototype.hasOwnProperty.call(PLATFORM_PKG, key)) {
    say('unsupported platform ' + key + '. Supported: ' + PLATFORMS.join(', ') + '.');
    return 1;
  }

  // First thing: a package without its bundle is an incomplete install, and what follows (Node's MODULE_NOT_FOUND
  // stack, the Go launcher's "LAUNCHER_BUNDLE_OVERRIDE ... is not a file") never says so.
  if (!deps.exists(deps.bundlePath)) {
    say('the CLI bundle ' + deps.bundlePath + ' is missing: the installation is incomplete.');
    say('reinstall it with: npm install -g ' + WRAPPER_PKG);
    return 1;
  }

  // --cli-background / --cli-foreground: explicit stdio override, stripped before the command sees the args.
  // Last flag wins. Default: inherit, so `task list | grep` reaches the pipe instead of being discarded.
  const rawArgs = deps.args;
  const args = rawArgs.filter((a) => a !== '--cli-background' && a !== '--cli-foreground');
  let stdio = 'inherit';
  for (const a of rawArgs) {
    if (a === '--cli-background') stdio = 'ignore';
    if (a === '--cli-foreground') stdio = 'inherit';
  }

  /** Runs bin; returns the exit code. An error without an exit status is explained on stderr. */
  const exec = (bin, binArgs, env, what, hint) => {
    try {
      deps.execFile(bin, binArgs, { stdio, windowsHide: true, env });
      return 0;
    } catch (err) {
      if (err != null && typeof err === 'object' && typeof err.status === 'number') return err.status;
      const code = err != null && typeof err === 'object' && typeof err.code === 'string' ? err.code : undefined;
      const signal = err != null && typeof err === 'object' && typeof err.signal === 'string' ? err.signal : undefined;
      const reason =
        signal !== undefined
          ? 'terminated by signal ' + signal
          : (code !== undefined ? code + ': ' : '') + (err instanceof Error ? err.message : String(err));
      say('cannot run ' + what + ' (' + bin + ') on ' + key + ': ' + reason);
      say(hint);
      return 1;
    }
  };

  if (args[0] !== 'start') {
    return exec(
      deps.nodePath,
      [deps.bundlePath].concat(args),
      deps.env,
      'node on the CLI bundle ' + deps.bundlePath,
      'check that node is installed and on PATH, or reinstall: npm install -g ' + WRAPPER_PKG
    );
  }

  // `start` only: the Go launcher supervises the background process.
  const pkgName = PLATFORM_PKG[key];
  const spec = pkgName + '/{{CLI_NAME}}' + (deps.platform === 'win32' ? '.exe' : '');
  let launcherPath;
  try {
    launcherPath = deps.resolve(spec);
  } catch {
    say('platform package ' + pkgName + ' missing -- installing...');
    try {
      deps.install(pkgName);
    } catch (installErr) {
      if (installErr && installErr.stdout) deps.stdout.write(String(installErr.stdout));
      if (installErr && installErr.stderr) deps.stderr.write(String(installErr.stderr));
      say('install of ' + pkgName + ' failed (exit ' + (installErr && installErr.status) + ')');
      say('fix: npm install -g ' + pkgName + '   (or reinstall everything: npm install -g ' + WRAPPER_PKG + ')');
      return 1;
    }
    try {
      launcherPath = deps.resolve(spec);
    } catch {
      say('installed ' + pkgName + ' but cannot resolve ' + spec);
      say('fix: npm install -g ' + WRAPPER_PKG);
      return 1;
    }
  }

  // npm tarballs of a platform package carry no exec bit when the CI artifact transfer dropped it, and npm only
  // chmods `bin` entries: make the launcher executable instead of failing with EACCES.
  if (deps.platform !== 'win32') {
    try {
      deps.assertExecutable(launcherPath);
    } catch {
      try {
        deps.makeExecutable(launcherPath);
      } catch (chmodErr) {
        say('the launcher ' + launcherPath + ' is not executable and chmod failed: ' + (chmodErr instanceof Error ? chmodErr.message : String(chmodErr)));
        say('fix: chmod +x "' + launcherPath + '"');
        return 1;
      }
    }
  }

  return exec(
    launcherPath,
    args,
    Object.assign({}, deps.env, { LAUNCHER_BUNDLE_OVERRIDE: deps.bundlePath }),
    'the launcher',
    'fix: chmod +x "' + launcherPath + '"  or reinstall: npm install -g ' + WRAPPER_PKG
  );
}

module.exports = { run };

if (require.main === module) {
  const cp = require('child_process');
  const fs = require('fs');
  const os = require('os');
  const path = require('path');
  process.exitCode = run({
    platform: process.platform,
    arch: os.arch(),
    args: process.argv.slice(2),
    env: process.env,
    nodePath: process.execPath,
    bundlePath: path.join(__dirname, '..', BUNDLE_FILE),
    exists: (p) => fs.existsSync(p),
    resolve: (spec) => require.resolve(spec),
    install: (pkg) => {
      const out = cp.execSync('npm install -g ' + pkg, { encoding: 'utf8', windowsHide: true, stdio: ['pipe', 'pipe', 'pipe'] });
      if (out) process.stdout.write(out);
    },
    execFile: (bin, binArgs, opts) => {
      cp.execFileSync(bin, binArgs, opts);
    },
    assertExecutable: (p) => fs.accessSync(p, fs.constants.X_OK),
    makeExecutable: (p) => fs.chmodSync(p, 0o755),
    stdout: process.stdout,
    stderr: process.stderr,
  });
}
