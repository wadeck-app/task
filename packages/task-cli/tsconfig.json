{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		// Resolve task-core and task-service from source (tsx, esbuild, IDE) instead of their built dist/.
		"paths": {
			"@wadeck-app/task-core": ["../task-core/src/index.ts"],
			"@wadeck-app/task-service": ["../task-service/src/index.ts"]
		},
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"composite": true,

		"sourceMap": true,
		"inlineSources": true,
		"noEmitOnError": true,

		"outDir": "dist",
		"declarationDir": "dist-types",
		"rootDir": "src",
		"types": ["vitest/globals", "node"]
	},
	"include": ["src"],
	"references": [{ "path": "../task-core" }, { "path": "../task-service" }]
}
