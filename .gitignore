# Dependencies
node_modules/

# Build output
dist/
dist-types/
dist-bundle/
*.tsbuildinfo

# Go launcher build artifacts -- not committed, built at deploy time
launcher-go/

# Prevent compiled files in src/ (should only be in dist/)
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/

# Temporary files
tmp/
temp/
*.tmp

# OS
Thumbs.db

# Generated entirely by CI -- do not commit
task-cli-dist/
task-cli-darwin-arm64/
task-cli-darwin-x64/
task-cli-win32-x64/

*-errors.log

# Browser verification screenshots
.claude/screenshots/
